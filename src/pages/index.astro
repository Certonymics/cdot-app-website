---
import Layout from "../layouts/Layout.astro";
import AppGallery from "../components/AppGallery.astro";
import StoreDropdown from "../components/StoreDropdown.astro";
import { cdotApplication } from "../lib/schema.js";

/* These follow the TAGLINE, not the hero. The hero names the four products -
   "identity, email, messaging, and payments" - where the tagline collapses the
   middle two into "communication". It is the tagline that is baked into og.png
   and sits in the header of every page, so a search result or a shared link
   that reads differently from the card beside it would look like a different
   product. These track the line that travels. */
const title = "cDot: Secure identity, communication and payments";
const description =
  "When apps and websites track everything you do, stay private online with cDot: the app for secure identity, communication and payments.";
const ogTitle = "cDot — Secure identity, communication and payments";
const ogDescription =
  "When apps and websites track everything you do, stay private online with cDot. Share only what you want, when you want — across identity, communication and payments.";

/* Ported from HowItWorks.jsx in 'Cdot site (main)'. Its `highlight` and
   `features` branches are dropped - no step there sets either. */
const HOW = [
  ["Download the app", "Get the free cDot app for iOS or Android."],
  ["Connect your email", "You’ll be able to send encrypted emails with your existing address, plus prove your identity and pay with just your email."],
  ["Scan your ID and take a selfie", "A one-time check that encrypts your identity information into anonymous attribute proofs."],
  ["Start using cDot", "Your encrypted identity is now tied to your email, powering private messaging, payments, and verification."],
];
---

<Layout title={title} description={description} ogTitle={ogTitle} ogDescription={ogDescription} extraSchema={[cdotApplication(Astro.site)]}>

<div class="hero">
  <div class="watermark" aria-hidden="true">
    <img src="/assets/Calque_1.svg" alt="" width="283" height="338" decoding="async">
  </div>
  <div class="wrap">
    <h1>The app for <span class="glow">secure identity, email, messaging, and payments</span>.</h1>
    <p class="sub">When apps and websites track everything you do, stay private online with cDot. Share only what you want, when you want.</p>
    <div class="hero-ctas">
      <StoreDropdown label="Download the app" id="dl-home" />
      <a class="btn btn-ghost" href="/network/">Discover the network</a>
    </div>
  </div>
</div>

<AppGallery />

<div class="divider"></div>

<section id="how-it-works">
  <div class="wrap">
    <h2>How it works</h2>
    <p class="lead">Protect your privacy in just a few minutes.</p>
    <!-- An <ol>, so the order is in the markup rather than only in the styling:
         the numbers are drawn by a CSS counter, and a reader who never sees
         them still gets a numbered list. -->
    <ol class="hiw">
      {HOW.map(([t, b]) => (
        <li>
          <div class="hiw-card">
            <h3>{t}</h3>
            <p>{b}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<div class="divider"></div>

<!-- Ported from WhyCdotExists.jsx in 'Cdot site (main)'. A teaser: the full
     version belongs on /about, which the closing link points at. -->
<section id="why">
  <div class="wrap">
    <h2>Why cDot exists</h2>
    <p class="lead">The internet never came with a way to prove who you are, keep your data private, or move money safely. cDot is the internet&rsquo;s missing piece: letting you move across the internet untracked and ensuring your money stays yours, whatever happens. Our network is run by a worldwide community — and because it&rsquo;s open-source, anyone can build on it.</p>
    <p class="lead why-more"><a href="/about/">Learn more about cDot</a></p>
  </div>
</section>

<div class="divider"></div>

<!-- Ported from NoDataStatement.jsx in 'Cdot site (main)'. Left-aligned and on
     our tokens; needs no styles of its own, being a heading and two leads. -->
<section id="privacy">
  <div class="wrap">
    <h2>Our goal is to protect your data, not collect it.</h2>
    <p class="lead">Most apps track your activity and harvest information about you. With cDot, you share anonymous proofs, not personal data, so you only reveal what you choose to. With no data business to protect, cDot is community-run, open-source, and borderless. You&rsquo;re in control of your identity, funds, and private keys. Our system just makes sure you never lose them.</p>
  </div>
</section>

<div class="divider"></div>

<section id="get-cdot">
  <div class="wrap">
    <div class="cta-banner">
      <h2>Ready to take control of your data?</h2>
      <p class="lead">Get started with cDot, the app for secure identity, communication and payments.</p>
      <div class="hero-ctas">
        <StoreDropdown label="Get cDot" id="dl-cta" />
        <a class="btn btn-ghost" href="https://cdot.world/" target="_blank" rel="noopener noreferrer">Explore the project</a>
      </div>
    </div>
  </div>
</section>

</Layout>

<style>
  /* A card, not a wash: gradients belong to heroes only (see global.css). */
  .cta-banner{
    padding:64px 32px;text-align:center;
    border:1px solid var(--line);border-radius:20px;
    background:linear-gradient(160deg,var(--card),transparent 60%);
  }
  .cta-banner h2,.cta-banner .lead{margin-inline:auto}
  .cta-banner .hero-ctas{justify-content:center}
  @media(max-width:640px){.cta-banner{padding:44px 20px}}
</style>
