---
import Layout from "../layouts/Layout.astro";
import { faqPage } from "../lib/schema.js";
import StoreDropdown from "../components/StoreDropdown.astro";
import { FAQ, faqHtml } from "../lib/faq.js";

const title = "FAQ — cDot";
const description =
  "Answers to common questions about cDot: what it is, how it works, why it was created, how to use it and how to run a C-Layer node.";

/* The same list drives the visible accordion and the FAQPage markup, so the two
   cannot disagree (search engines ignore markup that does not match the page). */
const items = FAQ.map((f) => ({ q: f.q, html: faqHtml(f.a) }));
const url = new URL(Astro.url.pathname, Astro.site).href;
---

<Layout title={title} description={description} extraSchema={[faqPage(url, items)]}>
  <div class="page-hero">
    <div class="wrap">
      <h1>FAQ</h1>
      <p class="sub">Everything you need to know about cDot.</p>
    </div>
  </div>

  <section id="faq">
    <div class="wrap">
      <div class="faq">
        {items.map((f) => (
          <details class="faq-item">
            <summary>
              <span>{f.q}</span>
              <span class="faq-mark" aria-hidden="true"></span>
            </summary>
            <div class="faq-a" set:html={f.html} />
          </details>
        ))}
      </div>
      <div class="hero-ctas">
        <StoreDropdown label="Get cDot" id="dl-faq" />
        <a class="btn btn-ghost" href="https://support.certonymity.com/hc/c-email/en" target="_blank" rel="noopener noreferrer">Read support docs</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* The accordion follows the hero directly, with no heading of its own, so the
     usual hero bottom padding, section padding and accordion top margin would
     stack into a large gap. Keep one modest gap instead. */
  .page-hero{min-height:0}
  .page-hero .wrap{padding-bottom:40px}
  #faq{padding-top:24px}
  #faq .faq{margin-top:0}
</style>
