---
/* Resources listing. Ported from c.email-website's Resources.jsx.
 *
 * The articles live in the c.Email Sanity project and are read at build time
 * (src/lib/sanity.js), so this page is plain static HTML - the original's
 * loading state, client-side fetch and embedded-data handoff are not needed.
 *
 * Rebuilt on this site's tokens, with c.Email's card sizes and spacing kept
 * (see PostCard).
 */
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import { getArticles, pickFeatured } from "../../lib/sanity.js";

const title = "Resources — cDot";
const description = "Privacy insights, news, and guides from the cDot team.";

const articles = await getArticles();
const featured = pickFeatured(articles);
const rest = articles.filter((a) => a !== featured);
---
<Layout title={title} description={description}>

<div class="page-hero">
  <div class="wrap">
    <h1>Resources</h1>
    <p class="sub">Privacy insights, news, and guides from the cDot team.</p>
  </div>
</div>

<section class="resources">
  <div class="wrap">
    {articles.length === 0 ? (
      <p class="empty">No articles yet — check back soon.</p>
    ) : (
      <div class="post-grid">
        {featured && <PostCard article={featured} featured />}
        {rest.map((article) => <PostCard article={article} />)}
      </div>
    )}
  </div>
</section>

</Layout>

<style>
  /* One column on a phone, two from 641px, three from 1024px - and the featured
     card spans two columns and two rows (see PostCard). Gap and section spacing
     as on c.Email's Resources page. */
  .resources{padding:48px 0}
  .post-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:20px}
  .empty{color:var(--ink-dim)}
  @media(min-width:641px){.post-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(min-width:768px){.resources{padding:64px 0}}
  @media(min-width:1024px){.post-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
</style>
