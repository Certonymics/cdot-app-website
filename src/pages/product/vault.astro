---
import Layout from "../../layouts/Layout.astro";
import StoreDropdown from "../../components/StoreDropdown.astro";

const title = "Vault — cDot";
const description =
  "Secure storage and recovery for any asset on cDot, built on its identity and asset recovery chain. More detail coming soon.";
---

<Layout title={title} description={description}>
  <div class="page-hero">
    <div class="wrap">
      <h1>Store and recover any asset</h1>
      <p class="sub">Coming soon.</p>
    </div>
  </div>
<section class="page-ctas page-ctas-first">
  <div class="wrap">
    <div class="hero-ctas">
      <StoreDropdown label="Get cDot" id="dl-cta" />
      <a class="btn btn-ghost" href="/faq/">Read full FAQ</a>
    </div>
  </div>
</section>

</Layout>
