---
/* One Resources card. The whole card is the link.
 *
 * Sized as on c.Email's Resources page: every card is 300px tall with a 150px
 * image, and the featured article is a 2x2 tile (620px = two rows and the gap)
 * on screens wider than a phone. On a phone the featured card is just another
 * card. Heights are fixed, so the excerpt is clamped and fades out where it is
 * cut, rather than ending mid-line.
 *
 * Card images are decorative (alt=""): the title beside them says what the
 * article is, and repeating it makes a screen reader read it twice.
 */
import { Image } from "astro:assets";
import { byline } from "../lib/sanity.js";

interface Props {
  article: any;
  featured?: boolean;
}
const { article, featured = false } = Astro.props;
const { cover } = article;
const Title = featured ? "h2" : "h3";

/* Output size follows the source, so a small upload is never stretched. */
const [maxW, maxH, steps] = featured ? [1200, 640, [600, 1200]] : [720, 327, [360, 720]];
const k = Math.min(1, (cover?.width ?? maxW) / maxW);
const width = Math.round(maxW * k);
const height = Math.round(maxH * k);
const widths = steps.filter((w) => w <= width);
const sizes = featured
  ? "(max-width: 1023px) 100vw, 700px"
  : "(max-width: 640px) 100vw, (max-width: 1023px) 50vw, 340px";
const meta = byline(article);
---
<a class:list={["post", { featured }]} href={`/resources/${article.slug}/`}>
  <div class="post-media">
    {cover?.url && (
      <Image src={cover.url} {width} {height} {widths} {sizes} format="webp" alt="" loading="lazy" />
    )}
  </div>
  <div class="post-body">
    {meta && <p class="post-meta">{meta}</p>}
    <Title class="post-title">{article.title}</Title>
    <p class="post-excerpt">{article.excerpt}</p>
  </div>
</a>

<style>
  .post{
    display:flex;flex-direction:column;height:300px;overflow:hidden;
    border:1px solid var(--line);border-radius:16px;
    background:linear-gradient(160deg,var(--card),transparent 60%);
    color:inherit;text-decoration:none;
    transition:border-color .2s,transform .2s;
  }
  .post:hover{border-color:rgba(var(--accent-rgb),.4);transform:translateY(-3px)}
  .post:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}

  .post-media{flex-shrink:0;height:150px;background:var(--bg-2)}
  .post-media :global(img){display:block;width:100%;height:100%;object-fit:cover}

  .post-body{display:flex;flex-direction:column;flex:1;min-height:0;padding:20px}
  .post-meta{flex-shrink:0;margin-bottom:8px;font-size:12px;line-height:1.4;color:var(--ink-faint)}
  .post-title{
    flex-shrink:0;margin-bottom:8px;
    font-family:"Host Grotesk Variable","Host Grotesk","Geist Variable","Geist",sans-serif;
    font-size:17.5px;font-weight:500;line-height:1.28;letter-spacing:-.005em;
    display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;
    transition:color .2s;
  }
  .post:hover .post-title{color:var(--cyan)}
  .post-excerpt{
    flex:1;min-height:0;overflow:hidden;
    color:var(--ink-dim);font-size:14.5px;line-height:1.6;
    display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;
    -webkit-mask-image:linear-gradient(to bottom,#000 calc(100% - 20px),transparent);
            mask-image:linear-gradient(to bottom,#000 calc(100% - 20px),transparent);
  }

  /* Featured: the 2x2 tile. The image takes whatever height the text leaves. */
  @media(min-width:641px){
    .post.featured{grid-column:span 2;grid-row:span 2;height:620px}
    .featured .post-media{flex:1;height:auto;min-height:160px}
    .featured .post-body{flex:none;padding:32px}
    .featured .post-meta{margin-bottom:12px;font-size:13px}
    .featured .post-title{
      margin-bottom:12px;font-size:clamp(26px,3vw,30px);line-height:1.2;
      display:block;-webkit-line-clamp:unset;overflow:visible;
    }
    .featured .post-excerpt{
      flex:none;font-size:16px;line-height:1.65;
      display:block;-webkit-line-clamp:unset;overflow:visible;
      -webkit-mask-image:none;mask-image:none;
    }
  }

  @media(max-width:640px){.post:hover{transform:none}}
  @media(prefers-reduced-motion:reduce){.post:hover{transform:none}}
</style>
