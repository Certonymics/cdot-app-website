---
/* Laid out like the c.Email footer: the mark on the left, the link row on the
   right, the copyright underneath. The regulatory note stays, as the quietest
   band at the very bottom. */
const year = new Date().getFullYear();

const PRESS_KIT =
  "https://drive.google.com/drive/folders/1UYjTCbeFVcCuDT5c1Arh30lFyIRep-kJ?usp=sharing";

const links = [
  { label: "About", href: "/about" },
  { label: "Press kit", href: PRESS_KIT, external: true },
  { label: "Contact", href: "/contact" },
  { label: "Support", href: "/support" },
  { label: "Terms", href: "/terms" },
  { label: "Privacy", href: "/privacy-policy" },
];
---
<footer>
  <div class="wrap">
    <div class="foot">
      <svg class="foot-mark" role="img" aria-label="cDot"><use href="#cdot-logo"/></svg>
      <nav class="foot-links" aria-label="Footer">
        {links.map((l) => (
          <a
            class="foot-link"
            href={l.href}
            {...(l.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          >{l.label}</a>
        ))}
      </nav>
    </div>

    <p class="foot-copy">&copy; {year} <a class="foot-link" href="https://certonymity.com/" target="_blank" rel="noopener noreferrer">Certonymity</a></p>

    <p class="foot-note">cDot is technical infrastructure. Any regulated activities, including banking and payments, are performed by licensed partners.</p>
  </div>
</footer>
