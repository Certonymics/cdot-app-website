---
import "@fontsource-variable/geist";
import "@fontsource-variable/host-grotesk";
import "@fontsource-variable/geist-mono";
import "../styles/tokens.css";
import "../styles/global.css";
import LogoSymbol from "../components/LogoSymbol.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { organization, website, webPage, breadcrumbList } from "../lib/schema.js";
import { heroSubtitle } from "../lib/seo.js";
/* ?url gives the same hashed file the @font-face rules point at, so the preload
   below matches the font the stylesheet will ask for. Only the two latin
   subsets every page paints on first view: Geist (body) and Host Grotesk
   (headings, including the H1 that is usually the largest paint). */
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import hostGroteskLatin from "@fontsource-variable/host-grotesk/files/host-grotesk-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  /* Optional: left out, it is the page's hero subtitle (see src/lib/seo.js), so
     the meta tags cannot drift from what the page says. Required for a page
     with no usable subtitle. */
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  /* For pages that are not destinations - currently only 404. Suppresses the
     canonical as well as adding the directive: a 404 naming itself canonical
     is asserting that the missing URL is the right one to index. */
  noindex?: boolean;
  /* Article pages. `ogImage` is an absolute URL to a 1200x630 image and
     replaces the site-wide card; `ogImageAlt` describes it. `extraSchema` is
     appended to the JSON-LD graph, and may reference the
     company's Organization by @id (orgId() in src/lib/schema.js). */
  ogType?: "website" | "article";
  ogImage?: string;
  ogImageAlt?: string;
  extraSchema?: object[];
  /* schema.org page type, where WebPage is too generic. */
  pageType?: "WebPage" | "AboutPage" | "ContactPage" | "CollectionPage";
  /* Breadcrumb between Home and this page, e.g. Blog above an article.
     `crumbName` names this page in the trail when the title is not what you
     want there. */
  breadcrumbs?: { name: string; path: string }[];
  crumbName?: string;
}
const {
  title,
  description: descriptionProp,
  ogTitle,
  ogDescription,
  noindex = false,
  ogType = "website",
  ogImage,
  ogImageAlt,
  extraSchema = [],
  pageType = "WebPage",
  breadcrumbs = [],
  crumbName,
} = Astro.props;
/* Render the page once, here, so its subtitle can be read before the head is
   written; the same string is what goes into <main> below. */
const body = await Astro.slots.render("default");
const description = descriptionProp ?? heroSubtitle(body);
if (!description) {
  throw new Error(
    `${Astro.url.pathname} has no description: pass \`description\` to <Layout>, or give the page a hero subtitle (<p class="sub">) of at least 70 characters.`,
  );
}
/* `site` is set in astro.config.mjs, so it is always defined here. */
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;

/* Structured data: see src/lib/schema.js. Every page gets the organisation and
   the website; an indexable one also gets itself and its breadcrumb (the
   homepage has no trail to show). Anything more specific comes in through
   `extraSchema`. The 404 is not a destination, so it describes none. */
const graph: object[] = [organization(site), website(site)];
if (!noindex) {
  const trail = Astro.url.pathname === "/" ? null : [
    { name: "cDot", url: site.href },
    ...breadcrumbs.map((b) => ({ name: b.name, url: new URL(b.path, site).href })),
    { name: crumbName ?? title.replace(/\s+[\u2014-]\s+cDot$/, ""), url: canonical },
  ];
  graph.push(webPage(site, { url: canonical, name: title, description, type: pageType, hasBreadcrumb: !!trail }));
  if (trail) graph.push(breadcrumbList(canonical, trail));
}
const orgSchema = { "@context": "https://schema.org", "@graph": [...graph, ...extraSchema] };
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
{/* crossorigin is required on a font preload even though it is same-origin:
     fonts are fetched in anonymous-CORS mode, and without it the preload is
     discarded and the font downloads twice. */}
<link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={hostGroteskLatin} as="font" type="font/woff2" crossorigin />
{/* Matches --bg-0 so mobile browser chrome does not disagree with the page.
     Kept in step with the theme by the script below; the value here is the
     light default, used until that script runs. */}
<meta name="theme-color" content="#FFFFFF" id="theme-color" />

{/*
  Theme. This script is deliberately BLOCKING and deliberately the first script
  in the document: it has to set data-theme before the browser paints, or a
  visitor who chose dark gets a flash of the light page on every single
  navigation. Moving it below the stylesheet, deferring it, or making it a
  module all reintroduce that flash.

  LIGHT IS THE UNCONDITIONAL DEFAULT. The site does not follow
  prefers-color-scheme - tokens.css carries the reasoning, in short that
  honouring it means stating a whole palette twice and the two copies drift.
  Dark is opt-in via the toggle, and the attribute is written only for that
  explicit choice: with nothing stored there is no attribute at all and the
  base :root palette (light) applies, which is also what JavaScript-disabled
  visitors get.
*/}
<script is:inline>
(function(){
  var KEY = 'cdot-theme';
  /* Duplicates --bg-0 from tokens.css, because the address-bar colour is a meta
     tag and cannot read a custom property. Change both together. */
  var DARK_BG = '#040b18', LIGHT_BG = '#FFFFFF';

  function stored(){
    try {
      var v = localStorage.getItem(KEY);
      return (v === 'light' || v === 'dark') ? v : null;
    } catch (e) { return null; }   /* private mode / storage disabled */
  }

  /* No prefers-color-scheme fallback: unset means light, always. */
  function effective(){ return stored() || 'light'; }

  function paint(){
    var s = stored();
    var root = document.documentElement;
    if (s) root.setAttribute('data-theme', s);
    else root.removeAttribute('data-theme');
    /* The address-bar colour is not reachable from CSS, so it is the one value
       that has to be pushed imperatively. */
    var meta = document.getElementById('theme-color');
    if (meta) meta.setAttribute('content', effective() === 'light' ? LIGHT_BG : DARK_BG);
  }

  function set(theme){
    try { localStorage.setItem(KEY, theme); } catch (e) {}
    paint();
  }

  window.__cdotTheme = { stored: stored, effective: effective, paint: paint, set: set };
  paint();
})();
</script>
<title>{title}</title>
<meta name="description" content={description} />
{noindex
  ? <meta name="robots" content="noindex, follow" />
  : <link rel="canonical" href={canonical} />}
<meta property="og:title" content={ogTitle ?? title} />
<meta property="og:description" content={ogDescription ?? description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="cDot" />
<meta property="og:locale" content="en_GB" />
<meta property="og:image" content={ogImage ?? new URL('/assets/og.png', site).href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImage ? (ogImageAlt ?? title) : "cDot - secure identity, communication and payments"} />
{/* The only twitter:* tag worth setting: X falls back to the og:* tags for
     title, description and image, but needs this to use the large card. */}
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)} />
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
{/* .ico fallback for Safari <15 and crawlers that request /favicon.ico */}
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
</head>
<body>
<a class="skip-link" href="#main">Skip to main content</a>
<LogoSymbol />
<Header />
<main id="main" tabindex="-1"><Fragment set:html={body} /></main>
<Footer />
</body>
</html>
